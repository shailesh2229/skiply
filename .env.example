# Copy to .env.local and fill ONE provider. Never prefix these with REACT_APP_ (that would ship the key to browsers).

# Microsoft Azure Speech (recommended: natural Hindi, Gujarati and Indian-English neural voices)
# Portal → Create resource → "Speech service" → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Google Cloud Text-to-Speech (alternative)
# Console → enable "Cloud Text-to-Speech API" → Credentials → API key (restrict it to that API)
GOOGLE_TTS_KEY=

# Optional: force a provider when both are set (azure | google)
TTS_PROVIDER=

# Google Places photos (real photo of nearly every venue). Enable "Places API (New)" for this key.
GOOGLE_PLACES_KEY=
# Optional: max Google photo lookups per day (cost guard). Default 1500.
GOOGLE_PHOTOS_DAILY_CAP=1500
